# Copy to .env for local runs. On Railway, put these under Variables instead.

# Required: the Anthropic key, plus Telegram and/or Teams
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=

# Microsoft Teams (Azure Bot, single tenant). See README.
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_TENANT_ID=
TEAMS_OWNER_ID=
# Where briefings and reminders go: auto, telegram, teams or both
# NOTIFY_CHANNEL=auto

# Only this Telegram user may talk to the bot (the bot tells you your ID on first message)
OWNER_TELEGRAM_ID=

# Google (Gmail, Calendar, Drive) - connect with /connect_google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Flight and hotel prices (serpapi.com, free ~250 searches/month)
SERPAPI_API_KEY=
# CURRENCY=ARS

# OneDrive - Azure app registration's client ID, then /connect_onedrive
MS_CLIENT_ID=
# MS_TENANT=common

# Strava (workouts from your watch) - connect with /connect_strava
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Voice messages (speech-to-text). Leave empty to switch voice off.
OPENAI_API_KEY=
# TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Spoken replies: auto (voice in -> voice out), always or off. Also /voice in Telegram.
# VOICE_REPLIES=auto
# Voice messages get short answers with less thinking, for speed.
# VOICE_EFFORT=low
# VOICE_MODEL=claude-haiku-5-5   (even faster and cheaper, a bit less smart)
# TTS_VOICE=onyx
# TTS_STYLE=Warm, cheerful and upbeat (Ragnar can also change voice and tone when you ask)

# Hands-free voice page: set automatically on Railway after 'Generate Domain'.
# WEB_URL=https://your-app.up.railway.app
# PORT=8080

# Optional
MODEL=claude-haiku-5-5
TIMEZONE=America/Argentina/Buenos_Aires
ASSISTANT_NAME=Secretario
OWNER_NAME=Roberto
CURRENCY=ARS
# Language for every reply
# LANGUAGE=Spanish from Argentina (rioplatense: use 'vos', natural and direct)
# Morning briefing time (HH:MM), or "off"
BRIEFING_TIME=07:00
# Weekly training review on Sundays (HH:MM), or "off"
WEEKLY_REVIEW_TIME=19:00
ENABLED_SKILLS=google,tasks,people,admin,content,research,writing,ideas
# All: google,outlook,tasks,research,admin,fitness,travel,onedrive,study,writing,ideas,content,career,budget,nutrition,habits,people,journal
# DATA_DIR=/data   (default: /data if a volume is mounted there, else ./data)
# HISTORY_TURNS=20
EXTRA_INSTRUCTIONS=
